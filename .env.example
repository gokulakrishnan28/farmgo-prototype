# ============================================================
# FarmGo Platform — Environment Variables Template
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- Database ---
# PostgreSQL or Supabase connection string
DATABASE_URL=postgresql://user:password@host:5432/farmgo

# --- Authentication ---
# Strong random secret key for JWT signing
SECRET_KEY=change-this-to-a-strong-random-secret

# --- AI / LLM ---
# Google Gemini API key (backend only — never expose in frontend)
GEMINI_API_KEY=your-gemini-api-key-here

# --- Government Market Data ---
# data.gov.in OGD API key (optional — CSV import works without it)
OGD_API_KEY=your-ogd-api-key-here

# --- Frontend (Vite) ---
# Google Maps API key (used for route display in farmer/transporter dashboards)
VITE_GOOGLE_MAPS_API_KEY=your-google-maps-api-key-here

# --- Feature Flags ---
# Set to true for SIH demo mode (uses realistic sample Maharashtra/Tamil Nadu data)
# Set to false to require live database data
DEMO_MODE=true
